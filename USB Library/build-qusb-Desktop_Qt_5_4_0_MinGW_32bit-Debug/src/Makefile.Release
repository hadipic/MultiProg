####### Install

install_headers: first FORCE
	@if not exist C:$(INSTALL_ROOT)\qusb\include\qusb mkdir C:$(INSTALL_ROOT)\qusb\include\qusb & if not exist C:$(INSTALL_ROOT)\qusb\include\qusb exit 1
	-$(INSTALL_FILE) "E:\Programming\Qt\MultiProg\USB Library\QUSB-master\src\global.h" C:$(INSTALL_ROOT)\qusb\include\qusb
	-$(INSTALL_FILE) "E:\Programming\Qt\MultiProg\USB Library\QUSB-master\src\device.h" C:$(INSTALL_ROOT)\qusb\include\qusb
	-$(INSTALL_FILE) "E:\Programming\Qt\MultiProg\USB Library\QUSB-master\src\handle.h" C:$(INSTALL_ROOT)\qusb\include\qusb
	-$(INSTALL_FILE) "E:\Programming\Qt\MultiProg\USB Library\QUSB-master\src\io.h" C:$(INSTALL_ROOT)\qusb\include\qusb
	-$(INSTALL_FILE) "E:\Programming\Qt\MultiProg\USB Library\QUSB-master\src\bulkio.h" C:$(INSTALL_ROOT)\qusb\include\qusb

uninstall_headers: FORCE
	-$(DEL_FILE) C:$(INSTALL_ROOT)\qusb\include\qusb\bulkio.h
	-$(DEL_FILE) C:$(INSTALL_ROOT)\qusb\include\qusb\io.h
	-$(DEL_FILE) C:$(INSTALL_ROOT)\qusb\include\qusb\handle.h
	-$(DEL_FILE) C:$(INSTALL_ROOT)\qusb\include\qusb\device.h
	-$(DEL_FILE) C:$(INSTALL_ROOT)\qusb\include\qusb\global.h
	-$(DEL_DIR) C:$(INSTALL_ROOT)\qusb\include\qusb 


install_target: first FORCE
	@if not exist C:$(INSTALL_ROOT)\qusb\lib mkdir C:$(INSTALL_ROOT)\qusb\lib & if not exist C:$(INSTALL_ROOT)\qusb\lib exit 1
	-$(INSTALL_FILE) "..\lib\libqusb.a" "C:$(INSTALL_ROOT)\qusb\lib\libqusb.a"
	-$(INSTALL_FILE) "$(DESTDIR_TARGET)" "C:$(INSTALL_ROOT)\qusb\lib\$(TARGET)"

uninstall_target: FORCE
	-$(DEL_FILE) "C:$(INSTALL_ROOT)\qusb\lib\libqusb.a" 
	 -$(DEL_FILE) "C:$(INSTALL_ROOT)\qusb\lib\$(TARGET)"
	-$(DEL_DIR) C:$(INSTALL_ROOT)\qusb\lib 


install:  install_headers install_target  FORCE

uninstall: uninstall_headers uninstall_target   FORCE

